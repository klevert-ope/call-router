NODE_ENV=production
PORT=3000
# Ended session, attempt, and tool-result retention. Active sessions are preserved.
SESSION_RETENTION_DAYS=30
PUBLIC_BASE_URL=https://switchboard.example.com
# Local development path. Compose overrides this with /app/data/switchboard.sqlite.
DATABASE_PATH=./data/switchboard.sqlite
# Telnyx number assigned to a credential-based SIP connection, in E.164 format.
TELNYX_FROM_NUMBER=+15551234567
# Optional explicit outbound caller ID. Omit to use BOSS_PERSONAL_NUMBER.
# OUTBOUND_CALLER_ID=+15551234567
# Linux Compose uses host networking. ARI is bound only to localhost.
ASTERISK_URL=http://127.0.0.1:8088/ari
ASTERISK_USERNAME=switchboard
# Use a random 64-character hex secret. Match deployment/asterisk/ari.conf.
ASTERISK_PASSWORD=replace-with-random-64-character-hex-secret
ASTERISK_APP=switchboard
# Asterisk endpoint name. SIP credentials live only in pjsip.conf.
TELNYX_ENDPOINT=telnyx-out
VAPI_ENDPOINT=vapi
# Default outbound identity only; inbound callers may use any phone number.
# Verify this number in Telnyx if using it as the outbound caller ID.
BOSS_PERSONAL_NUMBER=+971501234567
# Spoken as individual digits, with brief pauses allowed. No keypad input.
OPERATOR_PIN=1234
ADMIN_TOKEN=replace-with-32-or-more-random-characters
VAPI_WEBHOOK_SECRET=replace-with-different-32-or-more-random-characters
VAPI_API_KEY=replace-with-vapi-private-api-key
VAPI_PUBLIC_KEY=replace-with-vapi-public-api-key
VAPI_ASSISTANT_ID=replace-after-creating-assistant
VAPI_SIP_URI=sip:your-switchboard@sip.vapi.ai
# Match the Vapi SIP phone number's authentication and private pjsip.conf.
# These are separate from Vapi API keys; use 20-40 characters each.
VAPI_SIP_USERNAME=replace-with-vapi-sip-username
VAPI_SIP_PASSWORD=replace-with-vapi-sip-password
LOG_LEVEL=info
